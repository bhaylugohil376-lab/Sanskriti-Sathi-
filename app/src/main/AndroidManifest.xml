<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Sanskriti Sathi"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SanskritiSathi">

        <!-- Welcome / Launcher -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main -->
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".ExploreActivity" android:exported="false" />
        <activity android:name=".ProfessionalDashboardActivity" android:exported="false" />
        <activity android:name=".AudioSelectionActivity" android:exported="false" />
        <activity android:name=".FiltersActivity" android:exported="false" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".NotificationsActivity" android:exported="false" />

        <!-- Authentication -->
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".ForgotPasswordActivity" android:exported="false" />
        <activity android:name=".GoogleAuthActivity" android:exported="false" />

        <activity
            android:name=".AuthCallbackActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="sanskritisathi"
                    android:host="auth"
                    android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- Profile -->
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".MyProfileActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />

        <!-- Raja -->
        <activity android:name=".RajaActivity" android:exported="false" />
        <activity android:name=".RajaDetailActivity" android:exported="false" />

        <!-- Temple -->
        <activity android:name=".TempleActivity" android:exported="false" />

        <!-- Bhagavad Gita -->
        <activity android:name=".GitaActivity" android:exported="false" />
        <activity android:name=".GitaDetailActivity" android:exported="false" />

        <!-- Devi Devta -->
        <activity android:name=".DeviDevtaActivity" android:exported="false" />

        <!-- RSS -->
        <activity android:name=".RssActivity" android:exported="false" />

        <!-- About -->
        <activity android:name=".AboutActivity" android:exported="false" />

        <!-- Posts -->
        <activity android:name=".PostUploadActivity" android:exported="false" />

        <!-- Reels -->
        <activity
            android:name=".ReelActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReelUploadActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReelEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".NewReelActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReelCommentsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ReelEditActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Chat -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OneToOneChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
