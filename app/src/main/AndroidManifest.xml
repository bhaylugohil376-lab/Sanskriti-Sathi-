<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Sanskriti Sathi"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SanskritiSathi">

        <!-- Indian Kings -->
        <activity
            android:name=".RajaActivity"
            android:exported="false" />

        <!-- Temples -->
        <activity
            android:name=".TempleActivity"
            android:exported="false" />

        <!-- Bhagavad Gita -->
        <activity
            android:name=".GitaActivity"
            android:exported="false" />

        <!-- Devi & Devta -->
        <activity
            android:name=".DeviDevtaActivity"
            android:exported="false" />

        <!-- Sanskriti News -->
        <activity
            android:name=".RssActivity"
            android:exported="false" />

        <!-- Main Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
