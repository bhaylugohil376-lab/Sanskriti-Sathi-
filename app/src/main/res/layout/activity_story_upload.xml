<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Story"
            android:textColor="#E65100"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="18dp"/>

        <ImageView
            android:id="@+id/selectedStoryImage"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="#FFE0B2"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_foreground"
            android:contentDescription="Selected Story"/>

        <TextView
            android:id="@+id/selectedFileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photo select karein"
            android:textSize="14sp"
            android:textColor="#616161"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/galleryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🖼 Gallery"
                android:textAllCaps="false"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/cameraButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📷 Camera"
                android:textAllCaps="false"/>
        </LinearLayout>

        <EditText
            android:id="@+id/storyCaptionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Story caption..."
            android:gravity="top"
            android:minHeight="100dp"
            android:inputType="textCapSentences|textMultiLine"
            android:padding="14dp"
            android:layout_marginTop="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Who can see your Story?"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"/>

        <RadioGroup
            android:id="@+id/visibilityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/publicOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌍 Public — Everyone"
                android:textSize="16sp"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/followersOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 Followers — Only followers"
                android:textSize="16sp"/>
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ Story automatically expires after 24 hours."
            android:textColor="#757575"
            android:textSize="13sp"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/uploadStoryButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="➕ Publish Story"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>
