<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTempleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛕 Sanskriti Sathi"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvTempleSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mandir aur Dharmik Sthal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tvTempleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bharat ke prasiddh mandiron aur dharmik sthalon ki jankari yahan milegi."
            android:textSize="17sp"
            android:padding="10dp" />

    </LinearLayout>

</ScrollView>
