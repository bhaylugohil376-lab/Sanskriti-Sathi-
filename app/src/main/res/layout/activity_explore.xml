<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFDF7"
    android:clipToPadding="false"
>
 <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
  <TextView android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textSize="34sp" android:textColor="#3B2117"/>
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Explore" android:textColor="#3B2117" android:textSize="21sp" android:textStyle="bold"/>
 </LinearLayout>
 <EditText android:layout_width="match_parent" android:layout_height="50dp" android:layout_margin="14dp" android:hint="Search categories..." android:singleLine="true" android:paddingHorizontal="16dp" android:background="#FFF3E0"/>
 <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:padding="10dp">
  <TextView android:id="@+id/categoryCulture" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:gravity="center" android:text="🏛️\nCulture" android:textSize="18sp" android:textColor="#3B2117" android:background="#FFE0B2"/>
  <TextView android:id="@+id/categoryHistory" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:gravity="center" android:text="📜\nHistory" android:textSize="18sp" android:textColor="#3B2117" android:background="#FFE0B2"/>
  <TextView android:id="@+id/categoryKnowledge" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:gravity="center" android:text="📖\nKnowledge" android:textSize="18sp" android:textColor="#3B2117" android:background="#FFE0B2"/>
  <TextView android:id="@+id/categoryFestivals" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" android:gravity="center" android:text="🪔\nFestivals" android:textSize="18sp" android:textColor="#3B2117" android:background="#FFE0B2"/>
 </GridLayout>
</LinearLayout>
