<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFDF7"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="3dp">

        <TextView
            android:id="@+id/groupBackButton"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="34sp"
            android:textColor="#3B2117"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sanskriti Sathi Group"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#3B2117" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Culture • Knowledge • Tradition"
                android:textSize="12sp"
                android:textColor="#D96B27" />
        </LinearLayout>

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⋮"
            android:textSize="25sp"
            android:textColor="#3B2117" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/groupMessagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:overScrollMode="never" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="70dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <EditText
            android:id="@+id/groupMessageInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Group message likho..."
            android:textSize="15sp"
            android:textColor="#3B2117"
            android:textColorHint="#9A8579"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFF1E6"
            android:singleLine="true"
            android:maxLength="500"
            android:imeOptions="actionSend" />

        <Button
            android:id="@+id/groupSendButton"
            android:layout_width="54dp"
            android:layout_height="48dp"
            android:layout_marginStart="9dp"
            android:text="➤"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D96B27"
            android:contentDescription="Send group message" />
    </LinearLayout>
</LinearLayout>