<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#10151D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <!-- Logo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="ॐ"
            android:textColor="#D6A84F"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Sanskriti Sathi"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Apni Sanskriti • Apna Gaurav"
            android:textColor="#AEB6C2"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="42dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter your registered email and we'll send you a password reset link."
            android:textColor="#9DA7B5"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="25dp" />

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email Address"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="#D6A84F"
            app:hintTextColor="#9DA7B5"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#D6A84F">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F8997"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Reset Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="SEND RESET LINK"
            android:textColor="#10151D"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#D6A84F"
            app:cornerRadius="18dp"
            app:rippleColor="#55FFFFFF" />

        <!-- Back to Login -->
        <TextView
            android:id="@+id/backToLoginText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="← Back to Login"
            android:textColor="#D6A84F"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="✦  ॐ  ✦"
            android:textColor="#D6A84F"
            android:textSize="18sp"
            android:layout_marginTop="30dp" />

    </LinearLayout>

</ScrollView>
