<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/deviDevtaImage"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:contentDescription="Devi Devta image" />

        <TextView
            android:id="@+id/deviDevtaName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Devi Devta Name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deviDevtaTradition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="परंपरा"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/deviDevtaDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="विस्तृत विवरण"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/deviDevtaImportance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="महत्व"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/deviDevtaTemples"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="प्रमुख मंदिर / तीर्थ"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/deviDevtaFestivals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="प्रमुख पर्व"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/deviDevtaStories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="प्रमुख कथाएँ"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
