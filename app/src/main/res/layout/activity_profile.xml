<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ॐ  Sanskriti Sathi"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#311B5E"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F57C00"/>

        </LinearLayout>

        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Create Your Profile"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#311B5E"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Apni Sanskriti Sathi profile ko complete karein"
            android:textSize="14sp"
            android:textColor="#756B80"/>

        <!-- PROFILE ICON -->

        <TextView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="ॐ"
            android:textSize="54sp"
            android:textStyle="bold"
            android:textColor="#F57C00"
            android:background="#FFE0B2"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Profile photo baad mein bhi add kar sakte hain"
            android:textSize="12sp"
            android:textColor="#8A7F91"/>

        <!-- NAME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Name"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3E3545"/>

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:hint="Aapka naam"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textSize="16sp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:background="#FFFFFF"/>

        <!-- USERNAME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Username"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3E3545"/>

        <EditText
            android:id="@+id/usernameInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:hint="@username"
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textSize="16sp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:background="#FFFFFF"/>

        <!-- BIO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Bio"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3E3545"/>

        <EditText
            android:id="@+id/bioInput"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="7dp"
            android:gravity="top"
            android:hint="Apne baare mein likhein..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="150"
            android:padding="15dp"
            android:textSize="15sp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:background="#FFFFFF"/>

        <!-- PROFILE INFO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="15dp"
            android:orientation="vertical"
            android:background="#FFF3E0">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ Profile tip"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#E65100"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Bio jis bhasha mein likhenge, profile par wahi bhasha dikhegi."
                android:textSize="13sp"
                android:textColor="#6D625C"/>

        </LinearLayout>

        <!-- SAVE -->

        <Button
            android:id="@+id/saveProfileButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="SAVE &amp; CONTINUE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F57C00"/>

        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="संस्कृति • ज्ञान • परंपरा"
            android:textSize="12sp"
            android:textColor="#8A7F91"/>

    </LinearLayout>

</ScrollView>
