<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕉️"
                android:textSize="42sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Sanskriti Sathi"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="भारतीय संस्कृति • इतिहास • ज्ञान"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Welcome -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🙏 स्वागत है"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="भारत की संस्कृति, इतिहास, मंदिरों और आध्यात्मिक ज्ञान को एक ही स्थान पर जानें।"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp" />

        <!-- Culture Feed -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="📱 Sanskriti Feed"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/culturePostRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:layout_marginTop="6dp" />

        <!-- Explore -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="📚 Explore Sanskriti"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Raja -->
        <Button
            android:id="@+id/rajaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="58dp"
            android:text="👑  भारतीय राजा और इतिहास"
            android:textSize="17sp" />

        <!-- Temple -->
        <Button
            android:id="@+id/templeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="58dp"
            android:text="🛕  मंदिर और तीर्थ"
            android:textSize="17sp" />

        <!-- Gita -->
        <Button
            android:id="@+id/gitaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="58dp"
            android:text="📖  भगवद्गीता — 18 अध्याय"
            android:textSize="17sp" />

        <!-- Devi Devta -->
        <Button
            android:id="@+id/deviDevtaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="58dp"
            android:text="🕉️  देवी और देवता"
            android:textSize="17sp" />

        <!-- RSS -->
        <Button
            android:id="@+id/rssButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="58dp"
            android:text="📰  संस्कृति समाचार"
            android:textSize="17sp" />

        <!-- About -->
        <Button
            android:id="@+id/aboutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="58dp"
            android:text="ℹ️  Sanskriti Sathi के बारे में"
            android:textSize="17sp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="14dp"
            android:text="🇮🇳 ज्ञान • संस्कृति • विरासत"
            android:textSize="15sp"
            android:paddingBottom="24dp" />

    </LinearLayout>

</ScrollView>
