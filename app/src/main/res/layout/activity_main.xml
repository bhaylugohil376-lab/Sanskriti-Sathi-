<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F0">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <TextView
            android:id="@+id/createTopButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="+"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#F57C00"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Create"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ॐ  Sanskriti Sathi"
                android:textColor="#311B5E"
                android:textStyle="bold"
                android:textSize="21sp"
                android:maxLines="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="संस्कृति • ज्ञान • परंपरा"
                android:textColor="#F57C00"
                android:textSize="11sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/themeToggleButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="🌙"
            android:textSize="20sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Theme"/>

        <TextView
            android:id="@+id/notificationButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="🔔"
            android:textSize="20sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"/>

    </LinearLayout>

    <!-- STORIES -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:scrollbars="none"
        android:fillViewport="false"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- YOUR STORY -->
            <LinearLayout
                android:id="@+id/yourStoryButton"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp">

                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:src="@drawable/icon_foreground"
                        android:scaleType="centerCrop"
                        android:background="#FFE082"
                        android:contentDescription="Your story"/>

                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="bottom|end"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="#F57C00"/>

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Story"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="5dp"
                    android:maxLines="1"/>

            </LinearLayout>

            <!-- TEMPLE -->
            <LinearLayout
                android:id="@+id/templeStoryButton"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/somnath"
                    android:scaleType="centerCrop"
                    android:background="#FFB74D"
                    android:contentDescription="Temple"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛕 Temple"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <!-- RAJA -->
            <LinearLayout
                android:id="@+id/rajaStoryButton"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/icon_foreground"
                    android:scaleType="centerCrop"
                    android:background="#FFCC80"
                    android:contentDescription="Raja"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 Raja"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <!-- DEVI DEVTA -->
            <LinearLayout
                android:id="@+id/deviStoryButton"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/shiva"
                    android:scaleType="centerCrop"
                    android:background="#F8BBD0"
                    android:contentDescription="Devi Devta"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕉️ Devi-Devta"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <!-- GITA -->
            <LinearLayout
                android:id="@+id/gitaStoryButton"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/gita"
                    android:scaleType="centerCrop"
                    android:background="#D7CCC8"
                    android:contentDescription="Bhagavad Gita"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 Gita"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <!-- FESTIVAL -->
            <LinearLayout
                android:id="@+id/festivalStoryButton"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/rss"
                    android:scaleType="centerCrop"
                    android:background="#FFE0B2"
                    android:contentDescription="Festival"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉 Festival"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- SOCIAL FEED -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/homeFeedRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:overScrollMode="never"/>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="10dp">

        <LinearLayout
            android:id="@+id/homeNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="27sp"
                android:textColor="#F57C00"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="#F57C00"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/reelsNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textSize="25sp"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reels"
                android:textSize="11sp"
                android:textColor="#333333"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/chatNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="24sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textSize="11sp"
                android:textColor="#333333"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textSize="30sp"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:textSize="11sp"
                android:textColor="#333333"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◎"
                android:textSize="30sp"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="11sp"
                android:textColor="#333333"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
