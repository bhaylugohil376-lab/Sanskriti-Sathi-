<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🕉️ Sanskriti-Sathi"
            android:textSize="28sp"
            android:textStyle="bold"
            android:padding="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Indian Culture &amp; Knowledge"
            android:textSize="18sp"
            android:padding="8dp" />

        <Button
            android:id="@+id/rajaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👑 Indian Kings"
            android:textSize="17sp" />

        <Button
            android:id="@+id/templeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛕 Temples &amp; Pilgrimage"
            android:textSize="17sp" />

        <Button
            android:id="@+id/gitaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📖 Bhagavad Gita"
            android:textSize="17sp" />

        <Button
            android:id="@+id/deviDevtaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕉️ Devi &amp; Devta"
            android:textSize="17sp" />

        <Button
            android:id="@+id/rssButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📰 Sanskriti News"
            android:textSize="17sp" />

        <Button
            android:id="@+id/aboutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ About Sanskriti-Sathi"
            android:textSize="17sp" />

    </LinearLayout>

</ScrollView>
