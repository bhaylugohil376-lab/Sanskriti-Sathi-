<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F0">

    <!-- ========================= -->
    <!-- TOP HEADER -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <!-- CREATE -->

        <TextView
            android:id="@+id/createTopButton"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="＋"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#F57C00"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <!-- APP TITLE -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ॐ  Sanskriti Sathi"
                android:textColor="#311B5E"
                android:textStyle="bold"
                android:textSize="22sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="संस्कृति • ज्ञान • परंपरा"
                android:textColor="#F57C00"
                android:textSize="11sp"/>

        </LinearLayout>

        <!-- DAY / NIGHT -->

        <TextView
            android:id="@+id/themeToggleButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="🌙"
            android:textSize="21sp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <!-- NOTIFICATION -->

        <TextView
            android:id="@+id/notificationButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="🔔"
            android:textSize="21sp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>


    <!-- ========================= -->
    <!-- STORIES -->
    <!-- ========================= -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:scrollbars="none"
        android:background="#FFFFFF"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <!-- YOUR STORY -->

            <LinearLayout
                android:id="@+id/yourStoryButton"
                android:layout_width="82dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp">

                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:src="@drawable/icon_foreground"
                        android:scaleType="centerCrop"
                        android:background="#FFE082"/>

                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="bottom|end"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="#F57C00"/>

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Story"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


            <!-- TEMPLE -->

            <LinearLayout
                android:id="@+id/templeStoryButton"
                android:layout_width="82dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/somnath"
                    android:scaleType="centerCrop"
                    android:background="#FFB74D"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛕 Temple"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


            <!-- RAJA -->

            <LinearLayout
                android:id="@+id/rajaStoryButton"
                android:layout_width="82dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/icon_foreground"
                    android:scaleType="centerCrop"
                    android:background="#FFCC80"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 Raja"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


            <!-- DEVI DEVTA -->

            <LinearLayout
                android:id="@+id/deviStoryButton"
                android:layout_width="82dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/shiva"
                    android:scaleType="centerCrop"
                    android:background="#F8BBD0"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕉️ Devi-Devta"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


            <!-- GITA -->

            <LinearLayout
                android:id="@+id/gitaStoryButton"
                android:layout_width="82dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/gita"
                    android:scaleType="centerCrop"
                    android:background="#D7CCC8"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 Gita"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>


            <!-- FESTIVAL -->

            <LinearLayout
                android:id="@+id/festivalStoryButton"
                android:layout_width="82dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:src="@drawable/rss"
                    android:scaleType="centerCrop"
                    android:background="#FFE0B2"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉 Festival"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>


    <!-- ========================= -->
    <!-- FEED -->
    <!-- ========================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/homeFeedRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"/>


    <!-- ========================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="10dp">

        <!-- HOME -->

        <LinearLayout
            android:id="@+id/homeNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="27sp"
                android:textColor="#F57C00"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="#F57C00"/>

        </LinearLayout>


        <!-- REELS -->

        <LinearLayout
            android:id="@+id/reelsNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textSize="25sp"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reels"
                android:textSize="11sp"
                android:textColor="#333333"/>

        </LinearLayout>


        <!-- CHAT -->

        <LinearLayout
            android:id="@+id/chatNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="24sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textSize="11sp"
                android:textColor="#333333"/>

        </LinearLayout>


        <!-- SEARCH -->

        <LinearLayout
            android:id="@+id/searchNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌕"
                android:textSize="30sp"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:textSize="11sp"
                android:textColor="#333333"/>

        </LinearLayout>


        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/profileNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◎"
                android:textSize="30sp"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="11sp"
                android:textColor="#333333"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
