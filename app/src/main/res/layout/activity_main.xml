<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF8"
    android:fitsSystemWindows="true">

    <!-- ================= TOP BAR ================= -->

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- CREATE -->

        <TextView
            android:id="@+id/createTopButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+"
            android:textColor="#2F211B"
            android:textSize="30sp"
            android:textStyle="normal" />

        <!-- APP NAME -->

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="Sanskriti Sathi"
            android:textColor="#D86B27"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- NOTIFICATION -->

        <TextView
            android:id="@+id/notificationButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="♡"
            android:textColor="#2F211B"
            android:textSize="29sp" />

    </RelativeLayout>


    <!-- ================= MAIN CONTENT ================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:layout_below="@id/topBar"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================= STORIES ================= -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:background="#FFFFFF"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <!-- YOUR STORY -->

                    <LinearLayout
                        android:id="@+id/yourStoryButton"
                        android:layout_width="78dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:background="@drawable/bg_story_circle">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="+"
                                android:textColor="#D86B27"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Your Story"
                            android:textColor="#33251F"
                            android:textSize="11sp"
                            android:maxLines="1" />

                    </LinearLayout>


                    <!-- TEMPLES -->

                    <LinearLayout
                        android:id="@+id/templeStoryButton"
                        android:layout_width="78dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:background="@drawable/bg_story_circle">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="ॐ"
                                android:textColor="#D86B27"
                                android:textSize="25sp"
                                android:textStyle="bold" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Temples"
                            android:textColor="#33251F"
                            android:textSize="11sp"
                            android:maxLines="1" />

                    </LinearLayout>


                    <!-- RAJA -->

                    <LinearLayout
                        android:id="@+id/rajaStoryButton"
                        android:layout_width="78dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:background="@drawable/bg_story_circle">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="👑"
                                android:textSize="24sp" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Raja"
                            android:textColor="#33251F"
                            android:textSize="11sp"
                            android:maxLines="1" />

                    </LinearLayout>


                    <!-- DEVI DEVTA -->

                    <LinearLayout
                        android:id="@+id/deviStoryButton"
                        android:layout_width="78dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:background="@drawable/bg_story_circle">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="🪔"
                                android:textSize="24sp" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Devi Devta"
                            android:textColor="#33251F"
                            android:textSize="11sp"
                            android:maxLines="1" />

                    </LinearLayout>


                    <!-- GITA -->

                    <LinearLayout
                        android:id="@+id/gitaStoryButton"
                        android:layout_width="78dp"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:background="@drawable/bg_story_circle">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="📖"
                                android:textSize="24sp" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Gita"
                            android:textColor="#33251F"
                            android:textSize="11sp"
                            android:maxLines="1" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ================= FEED ================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeFeedRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:scrollbars="none" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ================= BOTTOM NAVIGATION ================= -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- HOME -->

        <ImageView
            android:id="@+id/homeNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Home"
            android:focusable="true"
            android:padding="16dp"
            android:src="@drawable/ic_home" />

        <!-- EXPLORE -->

        <ImageView
            android:id="@+id/exploreNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Explore"
            android:focusable="true"
            android:padding="16dp"
            android:src="@drawable/ic_explore" />

        <!-- REELS -->

        <ImageView
            android:id="@+id/reelsNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Reels"
            android:focusable="true"
            android:padding="16dp"
            android:src="@drawable/ic_reels" />

        <!-- MESSAGES -->

        <ImageView
            android:id="@+id/chatNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Messages"
            android:focusable="true"
            android:padding="16dp"
            android:src="@drawable/ic_chat" />

        <!-- PROFILE -->

        <ImageView
            android:id="@+id/profileNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Profile"
            android:focusable="true"
            android:padding="16dp"
            android:src="@drawable/ic_profile" />

    </LinearLayout>

</RelativeLayout>
