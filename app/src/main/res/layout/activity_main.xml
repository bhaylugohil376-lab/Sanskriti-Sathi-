<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🕉️ Sanskriti-Sathi"
            android:textSize="28sp"
            android:textStyle="bold"
            android:padding="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="भारतीय संस्कृति और ज्ञान का साथी"
            android:textSize="18sp"
            android:padding="8dp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛕 मंदिर और तीर्थस्थल" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📖 भगवद्गीता" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕉️ देवी-देवता" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📰 संस्कृति समाचार" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ About Sanskriti-Sathi" />

    </LinearLayout>

</ScrollView>
