<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="7dp"
            app:cardBackgroundColor="#FF6F00">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕉️"
                    android:textSize="48sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sanskriti Sathi"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="भारतीय संस्कृति और ज्ञान का डिजिटल साथी"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFF3E0"
                    android:gravity="center" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Section Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨ संस्कृति की दुनिया"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#6A1B9A"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp" />


        <!-- Raja -->
        <androidx.cardview.widget.CardView
            android:id="@+id/rajaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#FFF3E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="👑"
                    android:textSize="34sp"
                    android:background="#FFE0B2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="भारतीय राजा"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#E65100" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="महान राजाओं और उनके इतिहास को जानें"
                        android:textSize="13sp"
                        android:textColor="#6D4C41"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#E65100" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Temple -->
        <androidx.cardview.widget.CardView
            android:id="@+id/templeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#E8F5E9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="🛕"
                    android:textSize="32sp"
                    android:background="#C8E6C9" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="भारतीय मंदिर"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="मंदिरों का इतिहास और वास्तुकला"
                        android:textSize="13sp"
                        android:textColor="#455A64"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Devi Devta -->
        <androidx.cardview.widget.CardView
            android:id="@+id/deviDevtaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#FCE4EC">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="🕉️"
                    android:textSize="32sp"
                    android:background="#F8BBD0" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="देवी-देवता"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#AD1457" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="देवी-देवताओं की परंपरा और महत्व"
                        android:textSize="13sp"
                        android:textColor="#6D4C41"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#AD1457" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Gita -->
        <androidx.cardview.widget.CardView
            android:id="@+id/gitaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#EDE7F6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="📖"
                    android:textSize="32sp"
                    android:background="#D1C4E9" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="भगवद्गीता"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#4527A0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18 अध्यायों का ज्ञान और शिक्षाएँ"
                        android:textSize="13sp"
                        android:textColor="#5E35B1"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#4527A0" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- RSS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/rssButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#E3F2FD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="📰"
                    android:textSize="32sp"
                    android:background="#BBDEFB" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="संस्कृति समाचार"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="नई जानकारी और महत्वपूर्ण समाचार"
                        android:textSize="13sp"
                        android:textColor="#455A64"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Culture Posts -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cultureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#FFFDE7">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="📱"
                    android:textSize="32sp"
                    android:background="#FFF9C4" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Culture Posts"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#F57F17" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="संस्कृति से जुड़े पोस्ट देखें"
                        android:textSize="13sp"
                        android:textColor="#6D4C41"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#F57F17" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- About -->
        <androidx.cardview.widget.CardView
            android:id="@+id/aboutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:cardBackgroundColor="#F3E5F5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:gravity="center"
                    android:text="ℹ️"
                    android:textSize="30sp"
                    android:background="#E1BEE7" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="हमारे बारे में"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#7B1FA2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sanskriti Sathi के बारे में जानें"
                        android:textSize="13sp"
                        android:textColor="#6D4C41"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#7B1FA2" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🙏 हमारी संस्कृति • हमारा गौरव • हमारी पहचान"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#795548"
            android:gravity="center"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>
