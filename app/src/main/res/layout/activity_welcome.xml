<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8E1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:text="ॐ"
            android:textSize="72sp"
            android:textStyle="bold"
            android:textColor="#FF6F00"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Sanskriti Sathi"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="भारत की संस्कृति • ज्ञान • परंपरा"
            android:textSize="16sp"
            android:textColor="#616161"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="55dp"
            android:gravity="center"
            android:text="🌐 अपनी भाषा चुनें"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <Button
            android:id="@+id/hindiButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="25dp"
            android:text="🇮🇳  हिंदी"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/englishButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="🇬🇧  English"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/gujaratiButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="🪷  ગુજરાતી"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:gravity="center"
            android:text="एक भाषा चुनें और Sanskriti Sathi की यात्रा शुरू करें ✨"
            android:textSize="14sp"
            android:textColor="#757575"/>

    </LinearLayout>

</ScrollView>
