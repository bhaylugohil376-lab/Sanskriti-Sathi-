<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F0">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💬 Chat"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#311B5E"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sanskriti Sathi"
            android:textSize="11sp"
            android:textColor="#F57C00"/>

    </LinearLayout>


    <!-- TITLE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:text="Connect with people"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#222222"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:text="Private chat ya group conversation start karein."
        android:textSize="14sp"
        android:textColor="#666666"/>


    <!-- 1-TO-1 CHAT -->

    <LinearLayout
        android:id="@+id/oneToOneChatButton"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:elevation="3dp">

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="💬"
            android:textSize="30sp"
            android:background="#F3E5F5"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1-to-1 Chat"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#311B5E"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kisi ek user ke saath private chat"
                android:textSize="13sp"
                android:textColor="#777777"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="30sp"
            android:textColor="#F57C00"/>

    </LinearLayout>


    <!-- GROUP CHAT -->

    <LinearLayout
        android:id="@+id/groupChatButton"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:elevation="3dp">

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="👥"
            android:textSize="30sp"
            android:background="#FFF3E0"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Group Chat"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#311B5E"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Multiple users ke saath group conversation"
                android:textSize="13sp"
                android:textColor="#777777"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="30sp"
            android:textColor="#F57C00"/>

    </LinearLayout>


    <!-- INFORMATION -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:padding="16dp"
        android:text="🔐 Aapki conversations Firebase ke through securely store hongi."
        android:textSize="13sp"
        android:textColor="#666666"
        android:background="#FFF3E0"/>

</LinearLayout>
