<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit Reel"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/editorNextButton"
            android:layout_width="80dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="Next"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="#E4B54C"/>

    </LinearLayout>

    <!-- VIDEO PREVIEW -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <VideoView
            android:id="@+id/editorVideoPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#000000"/>

        <TextView
            android:id="@+id/editorVideoError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="20dp"
            android:text="Video preview unavailable"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- EDIT TOOLS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:scrollbars="none"
        android:background="#111111">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/toolAudio"
                android:layout_width="85dp"
                android:layout_height="65dp"
                android:gravity="center"
                android:text="🎵\nAudio"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/toolText"
                android:layout_width="85dp"
                android:layout_height="65dp"
                android:gravity="center"
                android:text="Aa\nText"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/toolVoice"
                android:layout_width="85dp"
                android:layout_height="65dp"
                android:gravity="center"
                android:text="🎙\nVoice"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/toolCaptions"
                android:layout_width="85dp"
                android:layout_height="65dp"
                android:gravity="center"
                android:text="CC\nCaptions"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/toolStickers"
                android:layout_width="85dp"
                android:layout_height="65dp"
                android:gravity="center"
                android:text="😊\nStickers"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/toolEdits"
                android:layout_width="85dp"
                android:layout_height="65dp"
                android:gravity="center"
                android:text="✂\nEdits"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>
