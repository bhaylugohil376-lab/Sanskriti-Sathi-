<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F111A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="30dp"
        android:gravity="center_horizontal">

        <!-- LOGO HEADER -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/ic_launcher_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="ॐ"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="#E5A93C"/>
        </FrameLayout>

        <!-- APP TITLE & SUBTITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sanskriti Sathi"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#E5A93C"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Login to continue your journey with our rich culture"
            android:textSize="13sp"
            android:textColor="#A0A5B5"
            android:gravity="center"/>

        <!-- EMAIL INPUT LABEL & EDITTEXT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Email or Mobile Number"
            android:textSize="14sp"
            android:textColor="#A0A5B5"/>

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A6072"
            android:background="#1A1D2B"/>

        <!-- PASSWORD INPUT LABEL & EDITTEXT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Password"
            android:textSize="14sp"
            android:textColor="#A0A5B5"/>

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:hint="Enter password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A6072"
            android:background="#1A1D2B"/>

        <!-- FORGOT PASSWORD -->
        <TextView
            android:id="@+id/forgotPasswordText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:text="Forgot Password?"
            android:textSize="13sp"
            android:textColor="#E5A93C"
            android:clickable="true"
            android:focusable="true"/>

        <!-- LOGIN BUTTON -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Login"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E5A93C"/>

        <!-- OR DIVIDER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="OR"
            android:textColor="#A0A5B5"
            android:textSize="12sp"/>

        <!-- GOOGLE SIGN-IN BUTTON -->
        <Button
            android:id="@+id/googleSignInButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Continue with Google"
            android:textSize="15sp"
            android:textColor="#0F111A"
            android:backgroundTint="#FFFFFF"/>

        <!-- REGISTER LINK -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textColor="#A0A5B5"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/registerTabText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#E5A93C"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
