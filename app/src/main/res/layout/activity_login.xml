<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:gravity="center_horizontal">

        <!-- LOGO -->

        <TextView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:gravity="center"
            android:text="ॐ"
            android:textSize="46sp"
            android:textStyle="bold"
            android:textColor="#311B5E"
            android:background="#FFE0B2"/>

        <!-- APP NAME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Sanskriti Sathi"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#311B5E"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="भारत की संस्कृति • ज्ञान • परंपरा"
            android:textSize="14sp"
            android:textColor="#756B80"/>

        <!-- LOGIN / CREATE ACCOUNT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Login"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#F57C00"/>

            <TextView
                android:id="@+id/registerTabText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Create Account"
                android:textSize="16sp"
                android:textColor="#555555"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- EMAIL LABEL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Email"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3E3545"/>

        <!-- EMAIL -->

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textSize="16sp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:background="#FFFFFF"/>

        <!-- PASSWORD LABEL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Password"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#3E3545"/>

        <!-- PASSWORD -->

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:hint="Enter your password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:textSize="16sp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:background="#FFFFFF"/>

        <!-- FORGOT PASSWORD -->

        <TextView
            android:id="@+id/forgotPasswordText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:text="Forgot Password?"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#F57C00"
            android:clickable="true"
            android:focusable="true"/>

        <!-- LOGIN -->

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="LOGIN"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F57C00"/>

        <!-- CREATE ACCOUNT -->

        <Button
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="CREATE NEW ACCOUNT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F57C00"
            android:backgroundTint="#FFF0D9"/>

        <!-- SECURITY INFO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="14dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#FFF3E0">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Your account is securely protected"
                android:textSize="13sp"
                android:textColor="#6D625C"/>

        </LinearLayout>

        <!-- BOTTOM -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Sanskriti Sathi • संस्कृति से जुड़ें"
            android:textSize="12sp"
            android:textColor="#8A7F91"/>

    </LinearLayout>

</ScrollView>
