<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reelItemRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ===================================================== -->
    <!-- FULL SCREEN VIDEO                                     -->
    <!-- ===================================================== -->

    <androidx.media3.ui.PlayerView
        android:id="@+id/reelPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true"
        android:useController="false"
        android:resize_mode="zoom"
        android:clipToPadding="false"
        android:clipChildren="false" />

    <!-- ===================================================== -->
    <!-- VIDEO ERROR                                            -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/reelErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:text="Video unavailable"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:background="#99000000" />

    <!-- ===================================================== -->
    <!-- BOTTOM GRADIENT-LIKE DARK OVERLAY                      -->
    <!-- ===================================================== -->

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/reel_bottom_gradient"
        android:clickable="false"
        android:focusable="false" />

    <!-- ===================================================== -->
    <!-- PROFILE + CAPTION                                      -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="90dp"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <!-- Profile row -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/reelProfileImage"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/reel_profile_circle"
                android:contentDescription="Profile"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/reelUsernameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Sanskriti User"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Caption -->

        <TextView
            android:id="@+id/reelCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- RIGHT SIDE ACTIONS                                     -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- LIKE -->

        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/reelLikeButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:padding="7dp"
                android:src="@drawable/btn_star_big_off"
                android:scaleType="centerInside"
                android:tint="#FFFFFF"
                android:contentDescription="Like" />

            <TextView
                android:id="@+id/reelLikesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

        <!-- COMMENT -->

        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/reelCommentButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_edit"
                android:scaleType="centerInside"
                android:tint="#FFFFFF"
                android:contentDescription="Comments" />

            <TextView
                android:id="@+id/reelCommentsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

        <!-- SHARE -->

        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/reelShareButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_share"
                android:scaleType="centerInside"
                android:tint="#FFFFFF"
                android:contentDescription="Share Reel" />

        </LinearLayout>

        <!-- DELETE -->

        <ImageButton
            android:id="@+id/reelDeleteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#FFFFFF"
            android:contentDescription="Delete Reel"
            android:visibility="gone" />

        <!-- VIEWS -->

        <TextView
            android:id="@+id/reelViewsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0 views"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
