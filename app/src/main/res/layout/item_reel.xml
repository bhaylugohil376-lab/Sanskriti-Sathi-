<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ===================================================== -->
    <!-- VIDEO -->
    <!-- ===================================================== -->

    <androidx.media3.ui.PlayerView
        android:id="@+id/reelPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true"
        android:focusable="false"
        android:clickable="false"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:show_buffering="when_playing"
        android:use_controller="false" />

    <!-- ===================================================== -->
    <!-- VIDEO ERROR -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/reelErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:text="Video unavailable"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#88000000"
        android:visibility="gone" />

    <!-- ===================================================== -->
    <!-- TOP GRADIENT-LIKE DARK AREA -->
    <!-- ===================================================== -->

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="#55000000"
        android:clickable="false" />

    <!-- ===================================================== -->
    <!-- PROFILE / USERNAME -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/reelProfileImage"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_myplaces"
            android:background="#444444"
            android:contentDescription="Profile" />

        <TextView
            android:id="@+id/reelUsernameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@SanskritiUser"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- RIGHT SIDE ACTIONS -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- LIKE -->

        <ImageButton
            android:id="@+id/reelLikeButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@android:drawable/btn_star_big_off"
            android:tint="#FFFFFF"
            android:contentDescription="Like"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/reelLikesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- COMMENT -->

        <ImageButton
            android:id="@+id/reelCommentButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:padding="9dp"
            android:src="@android:drawable/ic_dialog_info"
            android:tint="#FFFFFF"
            android:contentDescription="Comments"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/reelCommentsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- SHARE -->

        <ImageButton
            android:id="@+id/reelShareButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_share"
            android:tint="#FFFFFF"
            android:contentDescription="Share"
            android:clickable="true"
            android:focusable="true" />

        <!-- DELETE -->

        <ImageButton
            android:id="@+id/reelDeleteButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:padding="9dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#FFFFFF"
            android:contentDescription="Delete"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- BOTTOM DARK OVERLAY -->
    <!-- ===================================================== -->

    <View
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:clickable="false" />

    <!-- ===================================================== -->
    <!-- BOTTOM CONTENT -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="82dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <!-- CAPTION -->

        <TextView
            android:id="@+id/reelCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:ellipsize="end" />

        <!-- VIEWS -->

        <TextView
            android:id="@+id/reelViewsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
