<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ================= VIDEO ================= -->

    <androidx.media3.ui.PlayerView
        android:id="@+id/reelPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true"
        android:focusable="false"
        android:clickable="false"
        app:use_controller="false"
        app:show_buffering="when_playing"
        app:resize_mode="zoom"
        app:surface_type="texture_view" />

    <!-- ================= TOP GRADIENT ================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="top"
        android:background="#66000000"
        android:clickable="false" />

    <!-- ================= USER ================= -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/reelProfileImage"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="#333333"
            android:contentDescription="Profile"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_myplaces" />

        <TextView
            android:id="@+id/reelUsernameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Sanskriti User"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ================= RIGHT ACTIONS ================= -->

    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- LIKE -->

        <ImageButton
            android:id="@+id/reelLikeButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:contentDescription="Like"
            android:padding="7dp"
            android:src="@android:drawable/btn_star_big_off"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/reelLikesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- COMMENT -->

        <ImageButton
            android:id="@+id/reelCommentButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@android:color/transparent"
            android:contentDescription="Comments"
            android:padding="8dp"
            android:src="@android:drawable/ic_dialog_info"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/reelCommentsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- SHARE -->

        <ImageButton
            android:id="@+id/reelShareButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@android:color/transparent"
            android:contentDescription="Share"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_share"
            android:tint="#FFFFFF" />

        <!-- DELETE -->

        <ImageButton
            android:id="@+id/reelDeleteButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@android:color/transparent"
            android:contentDescription="Delete"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#FFFFFF"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ================= BOTTOM GRADIENT ================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_gravity="bottom"
        android:background="#77000000"
        android:clickable="false" />

    <!-- ================= BOTTOM CONTENT ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="82dp"
        android:layout_marginBottom="28dp"
        android:orientation="vertical">

        <!-- USERNAME AGAIN -->

        <TextView
            android:id="@+id/reelBottomUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sanskriti User"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- CAPTION -->

        <TextView
            android:id="@+id/reelCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- VIEWS -->

        <TextView
            android:id="@+id/reelViewsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0 views"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ================= VIDEO ERROR ================= -->

    <TextView
        android:id="@+id/reelErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:gravity="center"
        android:padding="18dp"
        android:text="Video unavailable"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
