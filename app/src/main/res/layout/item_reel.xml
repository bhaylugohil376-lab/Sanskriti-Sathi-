<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/reelPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        android:background="#000000" />

    <TextView
        android:id="@+id/reelErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Video unavailable"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Top user information -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#55000000">

        <ImageView
            android:id="@+id/reelProfileImage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/icon_foreground"
            android:scaleType="centerCrop"
            android:contentDescription="Profile" />

        <TextView
            android:id="@+id/reelUsernameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Sanskriti User"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/reelDeleteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#FFFFFF"
            android:contentDescription="Delete Reel"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Right side actions -->
    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/reelLikeButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/btn_star_big_off"
            android:tint="#FFFFFF"
            android:contentDescription="Like" />

        <TextView
            android:id="@+id/reelLikesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 likes"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <ImageButton
            android:id="@+id/reelCommentButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="#FFFFFF"
            android:contentDescription="Comments" />

        <TextView
            android:id="@+id/reelCommentsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 comments"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <ImageButton
            android:id="@+id/reelShareButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_share"
            android:tint="#FFFFFF"
            android:contentDescription="Share" />

        <TextView
            android:id="@+id/reelViewsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 views"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Bottom caption -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="80dp"
        android:paddingBottom="24dp"
        android:background="#66000000">

        <TextView
            android:id="@+id/reelCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Caption"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:maxLines="5"
            android:ellipsize="end" />

    </LinearLayout>

</FrameLayout>
