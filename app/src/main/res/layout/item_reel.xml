<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Reel Video -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/reelPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true"
        app:use_controller="false"
        app:resize_mode="zoom" />

    <!-- Video Error -->
    <TextView
        android:id="@+id/reelErrorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:padding="14dp"
        android:text="Video unavailable"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Top Gradient / Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#66000000" />

    <!-- Top User Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="18dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/reelProfileImage"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="Profile"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_foreground" />

        <TextView
            android:id="@+id/reelUsernameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sanskriti User"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/reelDeleteButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:contentDescription="Delete Reel"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#FFFFFF"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Right Side Actions -->
    <LinearLayout
        android:layout_width="68dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Like -->
        <ImageButton
            android:id="@+id/reelLikeButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@android:color/transparent"
            android:contentDescription="Like"
            android:padding="5dp"
            android:src="@android:drawable/btn_star_big_off"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/reelLikesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Comments -->
        <ImageButton
            android:id="@+id/reelCommentButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@android:color/transparent"
            android:contentDescription="Comments"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/reelCommentsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Share -->
        <ImageButton
            android:id="@+id/reelShareButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@android:color/transparent"
            android:contentDescription="Share"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_share"
            android:tint="#FFFFFF" />

        <!-- Views -->
        <TextView
            android:id="@+id/reelViewsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_gravity="bottom"
        android:background="#88000000" />

    <!-- Bottom Reel Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="86dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/reelBottomUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sanskriti User"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reelCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="5"
            android:text="Caption"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

</FrameLayout>
