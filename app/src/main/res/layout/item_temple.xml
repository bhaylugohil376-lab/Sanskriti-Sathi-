<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/templeImage"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:contentDescription="Temple image" />

        <TextView
            android:id="@+id/templeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Temple Name"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/templeLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="स्थान"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/templeHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="इतिहास"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/templeImportance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="धार्मिक महत्व"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/templeDeity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="मुख्य देवी/देवता"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/templeFestivals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="प्रमुख पर्व"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/templeTraditions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="विशेष परंपराएँ"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/templeArchitecture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="वास्तुकला"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:id="@+id/templeStories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="प्रमुख कथाएँ"
            android:textSize="17sp"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
