<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#10151D">

    <!-- ================= TOP BAR ================= -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:padding="11dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/profileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Profile"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#FFFFFF"
            android:contentDescription="Settings" />

    </RelativeLayout>


    <!-- ================= CONTENT ================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ================= PROFILE HEADER ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">

                <!-- PROFILE PHOTO -->

                <FrameLayout
                    android:layout_width="94dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center_vertical">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="94dp"
                        android:layout_height="94dp"
                        android:background="@drawable/profile_circle_background"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:contentDescription="Profile photo"
                        android:clickable="true"
                        android:focusable="true" />

                </FrameLayout>


                <!-- ================= STATS ================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1"
                    android:layout_marginStart="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <!-- POSTS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/postsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Posts"
                            android:textColor="#A7AFBB"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <!-- FOLLOWERS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/followersCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Followers"
                            android:textColor="#A7AFBB"
                            android:textSize="12sp" />

                    </LinearLayout>


                    <!-- FOLLOWING -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/followingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Following"
                            android:textColor="#A7AFBB"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ================= NAME / USERNAME / BIO ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="2dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sanskriti Sathi User"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profileUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@username"
                    android:textColor="#9CA5B2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/profileBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Apni Sanskriti • Apna Gaurav 🇮🇳"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="4" />

            </LinearLayout>


            <!-- ================= PROFILE BUTTONS ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Edit profile"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans"
                    app:backgroundTint="#202733"
                    app:cornerRadius="9dp"
                    app:strokeColor="#384250"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Share profile"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans"
                    app:backgroundTint="#202733"
                    app:cornerRadius="9dp"
                    app:strokeColor="#384250"
                    app:strokeWidth="1dp" />

            </LinearLayout>


            <!-- ================= SPACE ================= -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />


            <!-- ================= TABS ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- POSTS TAB -->

                <TextView
                    android:id="@+id/postsTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="▦"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <!-- REELS TAB -->

                <TextView
                    android:id="@+id/reelsTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#858E9B"
                    android:textSize="20sp" />

                <!-- SAVED TAB -->

                <TextView
                    android:id="@+id/savedTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="♡"
                    android:textColor="#858E9B"
                    android:textSize="28sp" />

            </LinearLayout>


            <!-- ================= TAB LINE ================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#29313C" />


            <!-- ================= POSTS GRID ================= -->

            <GridLayout
                android:id="@+id/profilePostsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="1"
                android:alignmentMode="alignBounds"
                android:useDefaultMargins="false"
                android:padding="1dp" />

            
            <!-- ================= EMPTY STATE ================= -->

            <TextView
                android:id="@+id/emptyProfileText"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:gravity="center"
                android:text="No posts yet"
                android:textColor="#7F8794"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
