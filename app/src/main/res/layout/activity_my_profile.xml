<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0F19">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:background="#0B0F19">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sanskriti Sathi"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/settingsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>


        <!-- PROFILE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp">

            <!-- PHOTO + STATS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- PROFILE PHOTO -->

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:padding="3dp"
                    android:background="@drawable/story_ring"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:background="@drawable/profile_circle_bg"
                        android:src="@drawable/icon_foreground"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        android:contentDescription="Profile photo"/>

                </FrameLayout>


                <!-- STATS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="12dp">

                    <!-- POSTS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/postsCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Posts"
                            android:textColor="#AAB2C0"
                            android:textSize="12sp"/>

                    </LinearLayout>


                    <!-- FOLLOWERS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/followersCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Followers"
                            android:textColor="#AAB2C0"
                            android:textSize="12sp"/>

                    </LinearLayout>


                    <!-- FOLLOWING -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/followingCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Following"
                            android:textColor="#AAB2C0"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- NAME -->

            <TextView
                android:id="@+id/nameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Sanskriti Sathi User"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>


            <!-- USERNAME -->

            <TextView
                android:id="@+id/usernameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@user"
                android:textColor="#FFB300"
                android:textSize="14sp"/>


            <!-- BIO -->

            <TextView
                android:id="@+id/bioText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Apni Sanskriti se judein."
                android:textColor="#D4D8E0"
                android:textSize="14sp"
                android:maxLines="3"
                android:lineSpacingExtra="2dp"/>


            <!-- BUTTONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/editProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Edit Profile"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#252D3D"/>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp"/>

                <Button
                    android:id="@+id/shareProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Share Profile"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#252D3D"/>

            </LinearLayout>

        </LinearLayout>


        <!-- HIGHLIGHTS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingStart="16dp"
            android:text="Highlights"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="5dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- NEW -->

                <LinearLayout
                    android:layout_width="78dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="27sp"
                        android:background="@drawable/profile_circle_bg"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="New"
                        android:textColor="#AAB2C0"
                        android:textSize="11sp"/>

                </LinearLayout>


                <!-- TEMPLES -->

                <LinearLayout
                    android:layout_width="78dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:background="@drawable/profile_circle_bg"
                        android:padding="2dp"
                        android:src="@drawable/somnath"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        android:contentDescription="Temples"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Temples"
                        android:textColor="#AAB2C0"
                        android:textSize="11sp"/>

                </LinearLayout>


                <!-- DEVI DEVTA -->

                <LinearLayout
                    android:layout_width="78dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:background="@drawable/profile_circle_bg"
                        android:padding="2dp"
                        android:src="@drawable/shiva"
                        android:scaleType="centerCrop"
                        android:clipToOutline="true"
                        android:contentDescription="Devi Devta"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Devi Devta"
                        android:textColor="#AAB2C0"
                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>


        <!-- TABS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="#111827"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/postsTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▦"
                android:textColor="#FFB300"
                android:textSize="22sp"/>

            <TextView
                android:id="@+id/reelsTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▶"
                android:textColor="#AAB2C0"
                android:textSize="19sp"/>

            <TextView
                android:id="@+id/repostsTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="↻"
                android:textColor="#AAB2C0"
                android:textSize="22sp"/>

            <TextView
                android:id="@+id/taggedTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♙"
                android:textColor="#AAB2C0"
                android:textSize="20sp"/>

        </LinearLayout>


        <!-- EMPTY CONTENT -->

        <LinearLayout
            android:id="@+id/contentEmpty"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No posts yet"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Posts aur Reels publish karne ke baad yahan dikhenge."
                android:textColor="#8F98A8"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
