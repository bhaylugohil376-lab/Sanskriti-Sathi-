<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp"
    android:background="#FFFFFF"
>

    <!-- Profile -->
    <ImageView
        android:id="@+id/commentProfileImage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_comment_avatar"
        android:contentDescription="Profile"
        android:scaleType="centerInside"
        android:src="@drawable/icon_foreground"/>

    <!-- Comment content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/commentUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sanskriti User"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/commentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Comment"
            android:textColor="#333333"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"/>

    </LinearLayout>

    <!-- Delete own comment -->
    <ImageButton
        android:id="@+id/commentDeleteButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="Delete comment"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="#999999"
        android:visibility="gone"/>

</LinearLayout>
