<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reelUploadRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000">

        <!-- ================= TOP BAR ================= -->

        <LinearLayout
            android:id="@+id/reelTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="#000000">

            <TextView
                android:id="@+id/reelBackButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:fontFamily="sans"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Create Reel"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"/>

        </LinearLayout>

        <!-- ================= VIDEO AREA ================= -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000">

            <!-- VIDEO -->

            <VideoView
                android:id="@+id/videoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone"
                android:background="#000000"/>

            <!-- EMPTY STATE -->

            <LinearLayout
                android:id="@+id/emptyVideoState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:background="#000000">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create a Reel"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Select a video to start"
                    android:textColor="#999999"
                    android:textSize="16sp"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- VIDEO NAME -->

            <TextView
                android:id="@+id/videoNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Select a video"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#66000000"/>

        </FrameLayout>

        <!-- ================= BOTTOM PANEL ================= -->

        <LinearLayout
            android:id="@+id/reelBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:background="#0A0A0A">

            <!-- CAPTION -->

            <EditText
                android:id="@+id/captionInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@android:color/transparent"
                android:hint="Write a caption..."
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:textSize="16sp"
                android:maxLength="1000"
                android:maxLines="2"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>

            <!-- VISIBILITY -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Who can see this?"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <RadioButton
                    android:id="@+id/publicRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:checked="true"
                    android:text="Public"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#E4B54C"/>

                <RadioButton
                    android:id="@+id/followersRadio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Followers"
                    android:textColor="#FFFFFF"
                    android:buttonTint="#E4B54C"/>

            </LinearLayout>

            <!-- UPLOAD PROGRESS -->

            <ProgressBar
                android:id="@+id/uploadProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"/>

            <!-- BUTTONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/selectVideoButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="Select Video"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:backgroundTint="#24262B"/>

                <Button
                    android:id="@+id/publishButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="Publish Reel"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#E4B54C"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
