<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ========================================================= -->
    <!-- VIDEO PREVIEW -->
    <!-- ========================================================= -->

    <VideoView
        android:id="@+id/videoPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#000000"
        android:visibility="gone"/>


    <!-- ========================================================= -->
    <!-- EMPTY PREVIEW -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/emptyPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create a Reel"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Share a short video with Sanskriti Sathi"
            android:textColor="#AAAAAA"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/selectVideoButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:minWidth="190dp"
            android:text="Select video"
            android:textAllCaps="false"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/selectedVideoHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Choose a vertical video for best results"
            android:textColor="#777777"
            android:textSize="12sp"/>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- TOP BAR -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#55000000">

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="New Reel"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"/>

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- VIDEO NAME -->
    <!-- ========================================================= -->

    <TextView
        android:id="@+id/videoNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="72dp"
        android:background="#66000000"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="14dp"
        android:paddingBottom="7dp"
        android:text="Video selected ✓"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"/>


    <!-- ========================================================= -->
    <!-- BOTTOM GRADIENT-LIKE DARK PANEL -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp"
        android:background="#DD000000">

        <!-- Caption -->

        <EditText
            android:id="@+id/captionInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:hint="Write a caption..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1000"
            android:maxLines="3"
            android:padding="0dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="15sp"/>


        <!-- Visibility -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Who can see this?"
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>

            <RadioButton
                android:id="@+id/publicRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:buttonTint="#D2A546"
                android:text="Public"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <RadioButton
                android:id="@+id/followersRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:buttonTint="#D2A546"
                android:text="Followers"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- Upload progress -->

        <ProgressBar
            android:id="@+id/uploadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"/>


        <!-- Upload status -->

        <TextView
            android:id="@+id/uploadStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Uploading..."
            android:textColor="#D2A546"
            android:textSize="12sp"
            android:visibility="gone"/>


        <!-- Publish -->

        <Button
            android:id="@+id/publishButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Publish Reel"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </LinearLayout>

</FrameLayout>
